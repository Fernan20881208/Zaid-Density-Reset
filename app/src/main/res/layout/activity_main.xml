<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_liquid_background">

    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#42040B16"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="8dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_glass_header"
            android:contentInsetStart="0dp"
            android:contentInsetEnd="0dp"
            android:elevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:id="@+id/headerLogo"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:contentDescription="@string/app_name"
                    android:scaleType="fitCenter" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/app_name"
                        android:textColor="@color/glass_text_primary"
                        android:textSize="22sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/app_subtitle"
                        android:textColor="@color/glass_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingBottom="36dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_panel"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/section_shizuku"
                        android:textColor="@color/glass_text_primary"
                        android:textSize="19sp" />

                    <TextView
                        android:id="@+id/statusInstallation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/status_checking"
                        android:textColor="@color/glass_text_secondary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/statusShizukuService"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="@string/status_checking"
                        android:textColor="@color/glass_text_secondary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/statusPermission"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="@string/status_checking"
                        android:textColor="@color/glass_text_secondary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/statusUserService"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="@string/status_checking"
                        android:textColor="@color/glass_text_secondary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/shizukuDiagnostics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/status_checking"
                        android:textColor="@color/glass_text_muted"
                        android:textIsSelectable="true"
                        android:textSize="12sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/buttonReconnectUserService"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_glass_button_secondary"
                        android:fontFamily="sans-serif-medium"
                        android:stateListAnimator="@null"
                        android:text="@string/reconnect_user_service"
                        android:textAllCaps="false"
                        android:textColor="@color/glass_text_primary"
                        app:backgroundTint="@null" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/buttonRequestPermission"
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_glass_button_primary"
                            android:fontFamily="sans-serif-medium"
                            android:stateListAnimator="@null"
                            android:text="@string/request_permission"
                            android:textAllCaps="false"
                            android:textColor="@color/glass_button_text"
                            app:backgroundTint="@null" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/buttonOpenShizuku"
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_glass_button_secondary"
                            android:fontFamily="sans-serif-medium"
                            android:stateListAnimator="@null"
                            android:text="@string/open_shizuku"
                            android:textAllCaps="false"
                            android:textColor="@color/glass_text_primary"
                            app:backgroundTint="@null" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_glass_panel"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/section_accessibility"
                        android:textColor="@color/glass_text_primary"
                        android:textSize="19sp" />

                    <TextView
                        android:id="@+id/statusAccessibility"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/status_checking"
                        android:textColor="@color/glass_text_secondary"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/accessibility_explanation"
                        android:textColor="@color/glass_text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/key_filter_warning"
                        android:textColor="@color/status_warning"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/volume_behavior_warning"
                        android:textColor="@color/glass_text_muted"
                        android:textSize="12sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/buttonAccessibilitySettings"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_glass_button_primary"
                        android:fontFamily="sans-serif-medium"
                        android:stateListAnimator="@null"
                        android:text="@string/open_accessibility_settings"
                        android:textAllCaps="false"
                        android:textColor="@color/glass_button_text"
                        app:backgroundTint="@null" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_glass_panel"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/section_settings"
                        android:textColor="@color/glass_text_primary"
                        android:textSize="19sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/gesture_duration_title"
                        android:textColor="@color/glass_text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/gesture_duration_value"
                        android:textColor="@color/glass_text_secondary"
                        android:textSize="14sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchBlockVolume"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/block_volume_title"
                        android:textColor="@color/glass_text_primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingEnd="52dp"
                        android:text="@string/block_volume_summary"
                        android:textColor="@color/glass_text_muted"
                        android:textSize="12sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchVibration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/vibrate_success_title"
                        android:textColor="@color/glass_text_primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingEnd="52dp"
                        android:text="@string/vibrate_success_summary"
                        android:textColor="@color/glass_text_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_glass_panel"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/section_test"
                        android:textColor="@color/glass_text_primary"
                        android:textSize="19sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/buttonTest"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_glass_button_primary"
                        android:fontFamily="sans-serif-medium"
                        android:stateListAnimator="@null"
                        android:text="@string/test_density_reset"
                        android:textAllCaps="false"
                        android:textColor="@color/glass_button_text"
                        app:backgroundTint="@null" />

                    <ProgressBar
                        android:id="@+id/testProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="14dp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/glass_accent_secondary"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/testResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/result_waiting"
                        android:textColor="@color/glass_text_secondary"
                        android:textIsSelectable="true"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_glass_panel"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/section_contact"
                        android:textColor="@color/glass_text_primary"
                        android:textSize="19sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="@string/contact_description"
                        android:textColor="@color/glass_text_secondary"
                        android:textSize="13sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/buttonInstagram"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_glass_button_secondary"
                        android:fontFamily="sans-serif-medium"
                        android:stateListAnimator="@null"
                        android:text="@string/instagram_button"
                        android:textAllCaps="false"
                        android:textColor="@color/glass_text_primary"
                        app:backgroundTint="@null" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:text="@string/developed_by"
                        android:textColor="@color/glass_text_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</FrameLayout>
