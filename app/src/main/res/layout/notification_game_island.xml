<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_notification_island"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="7dp"
    android:paddingEnd="8dp"
    android:paddingBottom="7dp">

    <ImageView
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_notification_density_island" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/islandTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/islandSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFC6CFDD"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/islandStopRecording"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:gravity="center"
        android:minWidth="42dp"
        android:paddingHorizontal="7dp"
        android:text="@string/notification_stop_recording"
        android:textColor="#FFFFC0B8"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/islandRestore"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:gravity="center"
        android:minWidth="48dp"
        android:paddingHorizontal="7dp"
        android:text="@string/notification_restore_short"
        android:textColor="#FF9DEAF4"
        android:textSize="10sp"
        android:textStyle="bold" />
</LinearLayout>
