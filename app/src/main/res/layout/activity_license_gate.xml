<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/licenseGateRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_liquid_background">

    <ImageView
        android:id="@+id/licenseBackgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#62040B16"
        android:importantForAccessibility="no" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingHorizontal="20dp"
        android:paddingVertical="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_glass_panel"
            android:clipToOutline="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:id="@+id/licenseLogo"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:contentDescription="@string/app_name"
                android:scaleType="centerCrop"
                android:src="@drawable/zaid_logo" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/license_activation_title"
                android:textColor="@color/glass_text_primary"
                android:textSize="24sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/license_activation_subtitle"
                android:textColor="@color/glass_text_secondary"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/licenseKeyInput"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_license_input"
                android:fontFamily="monospace"
                android:gravity="center_vertical"
                android:hint="@string/license_key_hint"
                android:imeOptions="actionDone"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLines="1"
                android:textColor="@color/glass_text_primary"
                android:textColorHint="@color/glass_text_muted"
                android:textSize="16sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonActivateLicense"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_glass_button_primary"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"
                android:text="@string/license_activate_button"
                android:textAllCaps="false"
                android:textColor="@color/glass_button_text"
                app:backgroundTint="@null" />

            <ProgressBar
                android:id="@+id/licenseProgress"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginTop="18dp"
                android:indeterminateTint="@color/glass_accent_secondary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/licenseGateStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/license_checking"
                android:textColor="@color/glass_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
