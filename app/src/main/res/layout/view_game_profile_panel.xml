<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gameProfilePanelRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:animateLayoutChanges="true"
    android:background="@drawable/bg_glass_panel"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="@string/section_game_profiles"
        android:textColor="@color/glass_text_primary"
        android:textSize="20sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/game_profiles_summary"
        android:textColor="@color/glass_text_secondary"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/select_game_title"
        android:textColor="@color/glass_text_primary"
        android:textSize="15sp" />

    <LinearLayout
        android:id="@+id/gameFreeFire"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_game_selector_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="92dp"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:id="@+id/gameFreeFireIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_game_icon"
            android:clipToOutline="true"
            android:contentDescription="@string/free_fire"
            android:padding="3dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_game_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/free_fire"
                android:textColor="@color/glass_text_primary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="com.dts.freefireth"
                android:textColor="@color/glass_text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/gameFreeFireInstalledState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/checking_installation"
                android:textColor="@color/glass_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/gameFreeFireCheck"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="12dp"
            android:alpha="0"
            android:background="@drawable/bg_selection_check"
            android:gravity="center"
            android:text="✓"
            android:textColor="@color/glass_button_text"
            android:textSize="16sp"
            android:visibility="invisible" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/gameFreeFireMax"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_game_selector_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="92dp"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:id="@+id/gameFreeFireMaxIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_game_icon"
            android:clipToOutline="true"
            android:contentDescription="@string/free_fire_max"
            android:padding="3dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_game_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/free_fire_max"
                android:textColor="@color/glass_text_primary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="com.dts.freefiremax"
                android:textColor="@color/glass_text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/gameFreeFireMaxInstalledState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/checking_installation"
                android:textColor="@color/glass_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/gameFreeFireMaxCheck"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="12dp"
            android:alpha="0"
            android:background="@drawable/bg_selection_check"
            android:gravity="center"
            android:text="✓"
            android:textColor="@color/glass_button_text"
            android:textSize="16sp"
            android:visibility="invisible" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/gameDensitySelectorContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:animateLayoutChanges="true"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/select_game_density_title"
            android:textColor="@color/glass_text_primary"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/gamePresetUltra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_density_preset"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="92dp"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingVertical="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/preset_ultra_title"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/preset_ultra_game_description"
                    android:textColor="@color/glass_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="20 DPI"
                android:textColor="@color/glass_accent_secondary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/gamePresetUltraCheck"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="10dp"
                android:alpha="0"
                android:gravity="center"
                android:text="✓"
                android:textColor="@color/glass_accent_secondary"
                android:textSize="17sp"
                android:visibility="invisible" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/gamePresetHigh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_density_preset"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="92dp"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingVertical="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/preset_high_title"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/preset_high_game_description"
                    android:textColor="@color/glass_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="72 DPI"
                android:textColor="@color/glass_accent_secondary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/gamePresetHighCheck"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="10dp"
                android:alpha="0"
                android:gravity="center"
                android:text="✓"
                android:textColor="@color/glass_accent_secondary"
                android:textSize="17sp"
                android:visibility="invisible" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/gamePresetLow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_density_preset"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="92dp"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingVertical="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/preset_low_title"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/preset_low_game_description"
                    android:textColor="@color/glass_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="280 DPI"
                android:textColor="@color/glass_accent_secondary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/gamePresetLowCheck"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="10dp"
                android:alpha="0"
                android:gravity="center"
                android:text="✓"
                android:textColor="@color/glass_accent_secondary"
                android:textSize="17sp"
                android:visibility="invisible" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="24dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonStartGameSession"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_glass_button_primary"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="@string/select_a_game"
            android:textAllCaps="false"
            android:textColor="@color/glass_button_text"
            app:backgroundTint="@null" />

        <ProgressBar
            android:id="@+id/gameSessionStartProgress"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="18dp"
            android:indeterminateTint="@color/glass_button_text"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/sessionProgressCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_glass_subcard"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/sessionProgressTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/game_session_preparing"
            android:textColor="@color/glass_text_primary"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/sessionProgressSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/glass_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/sessionCountdownContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="112dp"
                android:layout_height="112dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/sessionCountdownRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:indeterminate="false"
                    android:max="30"
                    android:progress="30"
                    app:indicatorColor="@color/glass_accent_secondary"
                    app:indicatorDirectionCircular="clockwise"
                    app:indicatorSize="104dp"
                    app:trackColor="@color/glass_track"
                    app:trackThickness="7dp" />

                <TextView
                    android:id="@+id/sessionSeconds"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:fontFamily="sans-serif-medium"
                    android:text="30"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="28sp" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/sessionStepSaved"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="○ DPI guardado"
            android:textColor="@color/glass_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/sessionStepRestarted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="○ Juego reiniciado"
            android:textColor="@color/glass_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/sessionStepActive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="○ Sesión activa"
            android:textColor="@color/glass_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/sessionStepRestore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="○ Restaurar DPI"
            android:textColor="@color/glass_text_secondary"
            android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonRestoreGameSessionNow"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_glass_button_secondary"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="@string/restore_now"
            android:textAllCaps="false"
            android:textColor="@color/glass_text_primary"
            app:backgroundTint="@null" />
    </LinearLayout>

    <TextView
        android:id="@+id/gameProfileError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_error_message"
        android:padding="14dp"
        android:textColor="@color/status_error"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
