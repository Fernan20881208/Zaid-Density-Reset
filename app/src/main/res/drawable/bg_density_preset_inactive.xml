<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="315"
                android:startColor="@color/density_preset_inactive_start"
                android:centerColor="@color/density_preset_inactive_center"
                android:endColor="@color/density_preset_inactive_end" />
            <stroke
                android:width="1dp"
                android:color="@color/density_preset_inactive_border" />
        </shape>
    </item>
    <item android:left="20dp" android:right="20dp" android:top="1dp">
        <shape android:shape="rectangle">
            <size android:height="1dp" />
            <corners android:radius="1dp" />
            <solid android:color="@color/density_preset_reflection_muted" />
        </shape>
    </item>
</layer-list>
